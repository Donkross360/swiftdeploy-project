services:
  app:
    image: {{APP_IMAGE}}
    container_name: swiftdeploy-app
    environment:
      MODE: "{{APP_MODE}}"
      VERSION: "{{APP_VERSION}}"
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    restart: {{RESTART_POLICY}}
    networks:
      - {{NETWORK_NAME}}

  nginx:
    image: {{NGINX_IMAGE}}
    container_name: swiftdeploy-nginx
    depends_on:
      - app
    ports:
      - "{{NGINX_PORT}}:{{NGINX_PORT}}"
    volumes:
      - ./generated/nginx.conf:/etc/nginx/nginx.conf:ro
      - {{LOGS_VOLUME_NAME}}:/var/log/nginx
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    restart: {{RESTART_POLICY}}
    networks:
      - {{NETWORK_NAME}}

networks:
  {{NETWORK_NAME}}:
    driver: {{NETWORK_DRIVER}}

volumes:
  {{LOGS_VOLUME_NAME}}:
