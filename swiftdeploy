#!/usr/bin/env bash
set -euo pipefail

# Resolve paths relative to this script so commands work from any cwd.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MANIFEST_PATH="$SCRIPT_DIR/manifest.yaml"
TEMPLATES_DIR="$SCRIPT_DIR/templates"
OUTPUT_DIR_NAME="${SWIFTDEPLOY_OUT_DIR:-template-output}"
if [[ "$OUTPUT_DIR_NAME" = /* ]]; then
  GENERATED_DIR="$OUTPUT_DIR_NAME"
else
  GENERATED_DIR="$SCRIPT_DIR/$OUTPUT_DIR_NAME"
fi
CHECK_ERROR=""

# log prints standard operator-facing progress lines.
log() {
  printf '[SWIFTDEPLOY] %s\n' "$1"
}

# hint prints actionable next-step guidance.
hint() {
  printf '[HINT] %s\n' "$1"
}

# die prints a fatal error and exits non-zero.
die() {
  printf '[SWIFTDEPLOY][ERROR] %s\n' "$1" >&2
  exit 1
}

# require_file guards commands from continuing with missing inputs.
require_file() {
  local path="$1"
  [[ -f "$path" ]] || die "required file not found: $path"
}

set_check_error() {
  CHECK_ERROR="$1"
}

# Read one scalar value from manifest.yaml using a section+key pair.
# This intentionally targets manifest schema.
manifest_try_get() {
  local section="$1"
  local key="$2"
  local value
  value="$(
    # We intentionally parse a flat, known schema instead of a generic YAML parser
    # so the CLI remains dependency-free.
    awk -v target_section="$section" -v target_key="$key" '
      BEGIN { in_section=0 }
      /^[[:space:]]*#/ { next }
      /^[a-zA-Z0-9_]+:[[:space:]]*$/ {
        current=$0
        sub(/:.*/, "", current)
        in_section=(current == target_section)
        next
      }
      in_section && $0 ~ "^[[:space:]]+" target_key ":[[:space:]]*" {
        line=$0
        sub(/^[[:space:]]+/, "", line)
        sub(target_key ":[[:space:]]*", "", line)
        sub(/[[:space:]]+#.*/, "", line)
        gsub(/^["'\''"]|["'\''"]$/, "", line)
        print line
        exit
      }
    ' "$MANIFEST_PATH"
  )"

  [[ -n "$value" ]] || return 1
  printf '%s' "$value"
}

manifest_get() {
  local section="$1"
  local key="$2"
  local value
  value="$(manifest_try_get "$section" "$key")" || die "missing manifest key: ${section}.${key}"
  printf '%s' "$value"
}

render_template() {
  local template_path="$1"
  local output_path="$2"
  shift 2

  # Copy template first, then apply token replacements in-place.
  cp "$template_path" "$output_path"
  while (($#)); do
    local token="$1"
    local replacement="$2"
    shift 2
    local safe_replacement
    # Escape sed-sensitive characters to avoid breaking rendered configs.
    safe_replacement="$(printf '%s' "$replacement" | sed -e 's/[\/&]/\\&/g')"
    sed -i "s|{{$token}}|$safe_replacement|g" "$output_path"
  done

  # Fail if any placeholder survives rendering to avoid partial configs.
  if grep -Eq '\{\{[A-Z0-9_]+\}\}' "$output_path"; then
    die "unresolved template token(s) in $output_path"
  fi
}

# init_cmd renders all generated artifacts from manifest + templates.
init_cmd() {
  require_file "$MANIFEST_PATH"
  require_file "$TEMPLATES_DIR/nginx.conf.tmpl"
  require_file "$TEMPLATES_DIR/docker-compose.yml.tmpl"

  mkdir -p "$GENERATED_DIR"

  local app_image app_port app_mode app_version
  local nginx_image nginx_port proxy_timeout error_service_name error_contact
  local opa_image opa_port
  local network_name network_driver logs_volume restart_policy

  # Resolve every manifest input up front so failures are explicit and early.
  app_image="$(manifest_get services image)"
  app_port="$(manifest_get services port)"
  app_mode="$(manifest_get services mode)"
  app_version="$(manifest_get services app_version)"

  nginx_image="$(manifest_get nginx image)"
  nginx_port="$(manifest_get nginx port)"
  proxy_timeout="$(manifest_get nginx proxy_timeout)"
  error_service_name="$(manifest_get nginx error_service_name)"
  error_contact="$(manifest_get nginx error_contact)"
  opa_image="$(manifest_get opa image)"
  opa_port="$(manifest_get opa port)"

  network_name="$(manifest_get network name)"
  network_driver="$(manifest_get network driver_type)"
  logs_volume="$(manifest_get logs volume_name)"
  restart_policy="$(manifest_get deploy restart_policy)"

  render_template \
    "$TEMPLATES_DIR/nginx.conf.tmpl" \
    "$GENERATED_DIR/nginx.conf" \
    "NGINX_PORT" "$nginx_port" \
    "APP_SERVICE_NAME" "app" \
    "APP_PORT" "$app_port" \
    "PROXY_TIMEOUT" "$proxy_timeout" \
    "ERROR_SERVICE_NAME" "$error_service_name" \
    "ERROR_CONTACT" "$error_contact"

  render_template \
    "$TEMPLATES_DIR/docker-compose.yml.tmpl" \
    "$GENERATED_DIR/docker-compose.yml" \
    "APP_IMAGE" "$app_image" \
    "APP_MODE" "$app_mode" \
    "APP_VERSION" "$app_version" \
    "APP_PORT" "$app_port" \
    "RESTART_POLICY" "$restart_policy" \
    "NETWORK_NAME" "$network_name" \
    "NGINX_IMAGE" "$nginx_image" \
    "NGINX_PORT" "$nginx_port" \
    "OPA_IMAGE" "$opa_image" \
    "OPA_PORT" "$opa_port" \
    "LOGS_VOLUME_NAME" "$logs_volume" \
    "NETWORK_DRIVER" "$network_driver"

  log "init complete: ${OUTPUT_DIR_NAME}/nginx.conf and ${OUTPUT_DIR_NAME}/docker-compose.yml"
}

run_check() {
  local label="$1"
  shift
  CHECK_ERROR=""
  if "$@"; then
    printf '[PASS] %s\n' "$label"
    return 0
  fi

  if [[ -n "$CHECK_ERROR" ]]; then
    printf '[FAIL] %s (%s)\n' "$label" "$CHECK_ERROR"
  else
    printf '[FAIL] %s\n' "$label"
  fi
  return 1
}

check_manifest_yaml() {
  if [[ ! -f "$MANIFEST_PATH" ]]; then
    set_check_error "manifest.yaml not found"
    return 1
  fi

  # First, perform a real YAML parse when a parser is available.
  if command -v python3 >/dev/null 2>&1 && python3 - <<'PY' "$MANIFEST_PATH" >/dev/null 2>&1
import sys
try:
    import yaml  # type: ignore
except Exception:
    raise SystemExit(2)

with open(sys.argv[1], "r", encoding="utf-8") as f:
    yaml.safe_load(f)
PY
  then
    :
  elif command -v ruby >/dev/null 2>&1 && ruby -e 'require "yaml"; YAML.safe_load(File.read(ARGV[0]), aliases: true)' "$MANIFEST_PATH" >/dev/null 2>&1; then
    :
  else
    # Fallback: enforce expected section layout for dependency-free environments.
    if ! awk '
    /^[[:space:]]*#/ { next }
    /^[a-zA-Z0-9_]+:[[:space:]]*$/ {
      sec=$0
      sub(/:.*/, "", sec)
      seen[sec]=1
    }
    END {
      required[1]="services"
      required[2]="nginx"
      required[3]="network"
      required[4]="logs"
      required[5]="deploy"
      for (i=1; i<=5; i++) {
        if (!seen[required[i]]) exit 1
      }
      exit 0
    }
    ' "$MANIFEST_PATH"; then
      set_check_error "manifest is unreadable and no YAML parser found (install python3+pyyaml or ruby)"
      return 1
    fi
  fi

  # Require expected top-level sections regardless of parser path used above.
  if awk '
    /^[[:space:]]*#/ { next }
    /^[a-zA-Z0-9_]+:[[:space:]]*$/ {
      sec=$0
      sub(/:.*/, "", sec)
      seen[sec]=1
    }
    END {
      required[1]="services"
      required[2]="nginx"
      required[3]="network"
      required[4]="logs"
      required[5]="deploy"
      for (i=1; i<=5; i++) {
        if (!seen[required[i]]) exit 1
      }
      exit 0
    }
  ' "$MANIFEST_PATH"; then
    return 0
  fi

  set_check_error "missing required top-level section(s)"
  return 1
}

check_required_fields() {
  local fields=(
    "services image"
    "services port"
    "services mode"
    "services app_version"
    "nginx image"
    "nginx port"
    "nginx proxy_timeout"
    "opa image"
    "opa port"
    "network name"
    "network driver_type"
    "logs volume_name"
    "policy data_file"
    "policy decision_timeout_seconds"
    "audit history_file"
    "audit report_file"
    "deploy restart_policy"
    "deploy health_timeout_seconds"
  )

  local pair section key value
  for pair in "${fields[@]}"; do
    section="${pair%% *}"
    key="${pair##* }"
    value="$(manifest_try_get "$section" "$key" || true)"
    if [[ -z "$value" ]]; then
      set_check_error "missing or empty ${section}.${key}"
      return 1
    fi
  done

  local app_mode
  app_mode="$(manifest_try_get services mode || true)"
  if [[ "$app_mode" != "stable" && "$app_mode" != "canary" ]]; then
    set_check_error "services.mode must be stable or canary"
    return 1
  fi

  return 0
}

check_image_exists() {
  if ! command -v docker >/dev/null 2>&1; then
    set_check_error "docker command not found (install/start Docker, then re-run validate)"
    return 1
  fi

  local app_image
  app_image="$(manifest_try_get services image || true)"
  if [[ -z "$app_image" ]]; then
    set_check_error "services.image is missing"
    return 1
  fi

  if docker image inspect "$app_image" >/dev/null 2>&1; then
    return 0
  fi

  set_check_error "docker image not found locally: $app_image (run ./swiftdeploy build && ./swiftdeploy validate)"
  return 1
}

build_cmd() {
  if ! command -v docker >/dev/null 2>&1; then
    die "docker command not found"
  fi

  require_file "$MANIFEST_PATH"
  require_file "$SCRIPT_DIR/Dockerfile"

  local app_image
  app_image="$(manifest_get services image)"

  log "building image: $app_image"
  if ! docker build -t "$app_image" "$SCRIPT_DIR"; then
    hint "review Dockerfile and app/ sources, then retry: ./swiftdeploy build"
    die "build failed for image: $app_image"
  fi
  log "build complete: $app_image"
}

compose_cmd() {
  docker compose -f "$GENERATED_DIR/docker-compose.yml" -p swiftdeploy "$@"
}

# read_policy_window_seconds loads canary window length from policy data.
# This keeps operational thresholds outside Rego and shell logic.
read_policy_window_seconds() {
  local data_file
  data_file="$(manifest_get policy data_file)"
  [[ "$data_file" = /* ]] || data_file="$SCRIPT_DIR/$data_file"
  [[ -f "$data_file" ]] || die "policy data file not found: $data_file"

  if ! command -v python3 >/dev/null 2>&1; then
    die "python3 command not found (required to parse policy data file)"
  fi

  python3 - <<'PY' "$data_file"
import json
import sys

path = sys.argv[1]
with open(path, "r", encoding="utf-8") as fh:
    data = json.load(fh)

window = data.get("canary", {}).get("window_seconds")
if not isinstance(window, int) or window <= 0:
    raise SystemExit("invalid canary.window_seconds in policy data file")

print(window)
PY
}

collect_host_stats_json() {
  if [[ ! -r /proc/loadavg || ! -r /proc/meminfo ]]; then
    die "host stats unavailable: /proc files not readable"
  fi

  local disk_free_kb disk_free_gb cpu_load mem_available_kb
  disk_free_kb="$(df -Pk / | awk 'NR==2{print $4}')"
  disk_free_gb="$(awk -v kb="$disk_free_kb" 'BEGIN{printf "%.2f", kb/1024/1024}')"
  cpu_load="$(awk '{print $1}' /proc/loadavg)"
  mem_available_kb="$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)"

  printf '{"context":"pre-deploy","disk_free_gb":%s,"cpu_load":%s,"mem_available_kb":%s}' \
    "$disk_free_gb" "$cpu_load" "$mem_available_kb"
}

# metrics_snapshot_json captures cumulative counters and current p99 estimate.
# The caller computes deltas between snapshots for windowed rates.
metrics_snapshot_json() {
  local nginx_port timeout_seconds metrics
  nginx_port="$(manifest_get nginx port)"
  timeout_seconds="$(manifest_get policy decision_timeout_seconds)"

  if ! command -v python3 >/dev/null 2>&1; then
    die "python3 command not found (required to parse metrics)"
  fi

  metrics="$(curl -fsS --connect-timeout 2 --max-time "$timeout_seconds" "http://127.0.0.1:${nginx_port}/metrics" 2>/dev/null || true)"
  [[ -n "$metrics" ]] || die "unable to scrape /metrics from nginx endpoint"

  python3 - <<'PY' <<<"$metrics"
import json
import math
import re
import sys

lines = sys.stdin.read().splitlines()
total = 0.0
errors = 0.0
buckets = {}

for line in lines:
    if line.startswith("http_requests_total{"):
        m = re.search(r'status_code="(\d+)"\} ([0-9eE+.\-]+)$', line)
        if not m:
            continue
        status = int(m.group(1))
        value = float(m.group(2))
        total += value
        if 500 <= status <= 599:
            errors += value
        continue
    if line.startswith("http_request_duration_seconds_bucket{"):
        m = re.search(r'le="([^"]+)"\} ([0-9eE+.\-]+)$', line)
        if not m:
            continue
        le = m.group(1)
        value = float(m.group(2))
        buckets[le] = buckets.get(le, 0.0) + value

total_obs = buckets.get("+Inf", 0.0)
p99_seconds = 0.0
if total_obs > 0:
    target = total_obs * 0.99
    ordered = []
    for k, v in buckets.items():
        if k == "+Inf":
            continue
        ordered.append((float(k), v))
    ordered.sort(key=lambda item: item[0])
    for le, cumulative in ordered:
        if cumulative >= target:
            p99_seconds = le
            break
    if p99_seconds == 0.0 and ordered:
        p99_seconds = ordered[-1][0]

print(json.dumps({
    "total_requests": total,
    "error_requests": errors,
    "p99_latency_ms": p99_seconds * 1000.0
}))
PY
}

# compute_canary_window_json derives windowed error rate and p99 payload
# used by pre-promote policy evaluation.
compute_canary_window_json() {
  local window_seconds="$1" start_snapshot end_snapshot
  start_snapshot="$(metrics_snapshot_json)"
  sleep "$window_seconds"
  end_snapshot="$(metrics_snapshot_json)"

  if ! command -v python3 >/dev/null 2>&1; then
    die "python3 command not found (required to compute canary window)"
  fi

  python3 - <<'PY' "$start_snapshot" "$end_snapshot" "$window_seconds"
import json
import sys

start = json.loads(sys.argv[1])
end = json.loads(sys.argv[2])
window = int(sys.argv[3])

delta_total = max(0.0, end["total_requests"] - start["total_requests"])
delta_errors = max(0.0, end["error_requests"] - start["error_requests"])
error_rate = 0.0 if delta_total == 0 else delta_errors / delta_total

print(json.dumps({
    "context": "pre-promote",
    "window_seconds": window,
    "error_rate": error_rate,
    "p99_latency_ms": end["p99_latency_ms"]
}))
PY
}

# opa_query_json performs a policy query and normalizes transport failures
# into distinct operator-facing outcomes.
opa_query_json() {
  local endpoint="$1" input_payload="$2"
  local opa_port timeout_seconds url response
  opa_port="$(manifest_get opa port)"
  timeout_seconds="$(manifest_get policy decision_timeout_seconds)"
  url="http://127.0.0.1:${opa_port}${endpoint}"

  if ! response="$(curl -sS --connect-timeout 2 --max-time "$timeout_seconds" \
    -H "Content-Type: application/json" \
    -X POST \
    "$url" \
    -d "{\"input\":${input_payload}}" 2>&1)"; then
    case "$response" in
      *"Connection refused"*|*"Failed to connect"*)
        die "policy engine unavailable: cannot connect to OPA on ${url}"
        ;;
      *"Operation timed out"*|*"timed out"*)
        die "policy engine timeout: OPA query exceeded ${timeout_seconds}s (${url})"
        ;;
      *)
        die "policy engine query failure: ${response}"
        ;;
    esac
  fi

  printf '%s' "$response"
}

# wait_for_opa_ready prevents policy checks from racing OPA startup.
wait_for_opa_ready() {
  local opa_port timeout_seconds
  opa_port="$(manifest_get opa port)"
  timeout_seconds="$(manifest_get policy decision_timeout_seconds)"

  local deadline=$((SECONDS + timeout_seconds + 5))
  while ((SECONDS < deadline)); do
    if curl -fsS --connect-timeout 1 --max-time 2 "http://127.0.0.1:${opa_port}/health" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done

  die "policy engine unavailable: OPA health endpoint did not become ready in time"
}

# print_policy_decision validates response shape and surfaces reasons.
# It returns success only when policy allow=true.
print_policy_decision() {
  local domain="$1" response_json="$2"
  if ! command -v python3 >/dev/null 2>&1; then
    die "python3 command not found (required to parse policy decision)"
  fi

  local parsed
  parsed="$(python3 - <<'PY' "$domain" "$response_json"
import json
import sys

domain = sys.argv[1]
raw = sys.argv[2]
try:
    payload = json.loads(raw)
except Exception as exc:
    print(f"PARSE_ERROR::{exc}")
    raise SystemExit(0)

result = payload.get("result")
if not isinstance(result, dict):
    code = payload.get("code")
    if code == "undefined_document":
        print("PARSE_ERROR::requested policy document is undefined (policy not loaded or wrong path)")
        raise SystemExit(0)
    compact = json.dumps(payload, sort_keys=True)
    print(f"PARSE_ERROR::missing 'result' object in OPA response: {compact}")
    raise SystemExit(0)

allow = result.get("allow")
summary = result.get("summary", "")
violations = result.get("violations", [])
if not isinstance(violations, list):
    violations = []

print(f"ALLOW::{str(bool(allow)).lower()}")
print(f"SUMMARY::{summary}")
for item in violations:
    if isinstance(item, dict):
        msg = item.get("message", json.dumps(item, sort_keys=True))
    else:
        msg = str(item)
    print(f"VIOLATION::{msg}")
PY
)"

  local allow_line summary_line parse_error
  parse_error="$(printf '%s\n' "$parsed" | awk -F'::' '$1=="PARSE_ERROR"{print $2; exit}')"
  if [[ -n "$parse_error" ]]; then
    die "policy engine returned invalid response for ${domain}: ${parse_error}"
  fi

  allow_line="$(printf '%s\n' "$parsed" | awk -F'::' '$1=="ALLOW"{print $2; exit}')"
  summary_line="$(printf '%s\n' "$parsed" | awk -F'::' '$1=="SUMMARY"{print $2; exit}')"
  [[ -n "$summary_line" ]] && log "policy ${domain}: ${summary_line}"

  if [[ "$allow_line" == "true" ]]; then
    return 0
  fi

  printf '%s\n' "$parsed" | awk -F'::' '$1=="VIOLATION"{printf "[POLICY][%s] %s\n", "'$domain'", $2}'
  return 1
}

# run_policy_gate centralizes query + decision parsing for each domain.
run_policy_gate() {
  local domain="$1" endpoint="$2" payload_json="$3"
  local response_json
  response_json="$(opa_query_json "$endpoint" "$payload_json")"
  if print_policy_decision "$domain" "$response_json"; then
    return 0
  fi
  return 1
}

# pre_deploy_gate asks infrastructure policy before any deploy action.
pre_deploy_gate() {
  local payload
  wait_for_opa_ready
  payload="$(collect_host_stats_json)"
  if ! run_policy_gate "infrastructure" "/v1/data/infrastructure/decision" "$payload"; then
    die "deploy blocked by infrastructure policy"
  fi
}

# pre_promote_gate evaluates canary health over configured time window.
pre_promote_gate() {
  local window_seconds payload
  wait_for_opa_ready
  window_seconds="$(read_policy_window_seconds)"
  log "policy canary: collecting metrics window (${window_seconds}s)"
  payload="$(compute_canary_window_json "$window_seconds")"
  if ! run_policy_gate "canary" "/v1/data/canary/decision" "$payload"; then
    die "promote blocked by canary policy"
  fi
}

update_manifest_mode() {
  local target_mode="$1"
  local tmp_file
  tmp_file="$(mktemp)"

  awk -v target_mode="$target_mode" '
    BEGIN { in_services=0 }
    /^[a-zA-Z0-9_]+:[[:space:]]*$/ {
      sec=$0
      sub(/:.*/, "", sec)
      in_services=(sec == "services")
    }
    in_services && /^[[:space:]]+mode:[[:space:]]*/ {
      print "  mode: " target_mode
      next
    }
    { print }
  ' "$MANIFEST_PATH" >"$tmp_file"

  mv "$tmp_file" "$MANIFEST_PATH"
}

wait_for_health() {
  local timeout_seconds="$1"
  local nginx_port
  nginx_port="$(manifest_get nginx port)"
  local deadline=$((SECONDS + timeout_seconds))

  if ! command -v curl >/dev/null 2>&1; then
    die "curl command not found (required for health checks)"
  fi

  while ((SECONDS < deadline)); do
    local body
    body="$(curl -fsS "http://127.0.0.1:${nginx_port}/healthz" 2>/dev/null || true)"
    if [[ -n "$body" ]]; then
      local compact
      compact="$(printf '%s' "$body" | tr -d '[:space:]')"
      if [[ "$compact" == *'"status":"ok"'* ]]; then
        return 0
      fi
    fi
    sleep 2
  done

  return 1
}

deploy_cmd() {
  local health_timeout
  health_timeout="$(manifest_get deploy health_timeout_seconds)"

  log "deploy: rendering configs"
  init_cmd

  # Start policy sidecar first so pre-deploy gate can query OPA.
  log "deploy: starting policy sidecar"
  compose_cmd up -d --no-deps opa

  if ! check_image_exists; then
    log "deploy: app image missing locally; running build"
    build_cmd
  fi

  log "deploy: running pre-deploy policy gate"
  pre_deploy_gate

  log "deploy: running preflight validation"
  validate_cmd

  log "deploy: starting stack"
  compose_cmd up -d --remove-orphans

  log "deploy: waiting for healthz readiness (timeout: ${health_timeout}s)"
  if ! wait_for_health "$health_timeout"; then
    hint "inspect container logs: docker compose -f ${OUTPUT_DIR_NAME}/docker-compose.yml -p swiftdeploy logs"
    die "deploy failed: health check timeout after ${health_timeout}s"
  fi

  log "deploy complete: stack is healthy"
}

promote_cmd() {
  local target_mode="${1:-}"
  [[ "$target_mode" == "stable" || "$target_mode" == "canary" ]] || die "usage: ./swiftdeploy promote <stable|canary>"

  local current_mode
  current_mode="$(manifest_get services mode)"
  local health_timeout
  health_timeout="$(manifest_get deploy health_timeout_seconds)"

  # Canary health gate is required before promoting out of canary.
  if [[ "$current_mode" == "canary" && "$target_mode" == "stable" ]]; then
    log "promote: running pre-promote policy gate"
    pre_promote_gate
  fi

  log "promote: updating manifest mode to ${target_mode}"
  update_manifest_mode "$target_mode"

  log "promote: regenerating configs from updated manifest"
  init_cmd

  log "promote: restarting app container only"
  compose_cmd up -d --no-deps --force-recreate app

  log "promote: waiting for /healthz"
  if ! wait_for_health "$health_timeout"; then
    hint "inspect app logs: docker compose -f ${OUTPUT_DIR_NAME}/docker-compose.yml -p swiftdeploy logs app"
    die "promote failed: health check timeout after ${health_timeout}s"
  fi

  local nginx_port mode_header
  nginx_port="$(manifest_get nginx port)"
  mode_header="$(curl -sS -D - -o /dev/null "http://127.0.0.1:${nginx_port}/healthz" | tr -d '\r' | awk -F': ' 'tolower($1)=="x-mode" {print $2}' || true)"
  if [[ "$target_mode" == "canary" && "$mode_header" != "canary" ]]; then
    die "promote verification failed: expected X-Mode=canary on /healthz"
  fi
  if [[ "$target_mode" == "stable" && -n "$mode_header" ]]; then
    die "promote verification failed: expected no X-Mode header in stable mode"
  fi

  log "promote complete: mode=${target_mode} verified via /healthz"
}

teardown_cmd() {
  local clean_flag="${1:-}"

  log "teardown: removing containers, network, and volumes"
  if [[ -f "$GENERATED_DIR/docker-compose.yml" ]]; then
    compose_cmd down -v --remove-orphans || true
  else
    log "teardown: generated compose file not found, skipping compose down"
  fi

  if [[ "$clean_flag" == "--clean" ]]; then
    log "teardown: removing generated configs"
    rm -f "$GENERATED_DIR/nginx.conf" "$GENERATED_DIR/docker-compose.yml"
  elif [[ -n "$clean_flag" ]]; then
    die "usage: ./swiftdeploy teardown [--clean]"
  fi

  log "teardown complete"
}

check_nginx_port_available() {
  if ! command -v ss >/dev/null 2>&1; then
    set_check_error "ss command not found"
    return 1
  fi

  local nginx_port
  nginx_port="$(manifest_try_get nginx port || true)"
  if [[ -z "$nginx_port" ]]; then
    set_check_error "nginx.port is missing"
    return 1
  fi

  if ss -ltn | awk -v p=":${nginx_port}$" 'NR > 1 && $4 ~ p { found=1 } END { exit found ? 0 : 1 }'; then
    set_check_error "port ${nginx_port} is already in use"
    return 1
  fi

  return 0
}

check_nginx_syntax() {
  if ! command -v docker >/dev/null 2>&1; then
    set_check_error "docker command not found (install/start Docker, then re-run validate)"
    return 1
  fi

  local nginx_image
  nginx_image="$(manifest_try_get nginx image || true)"
  if [[ -z "$nginx_image" ]]; then
    set_check_error "nginx.image is missing"
    return 1
  fi

  if [[ ! -f "$GENERATED_DIR/nginx.conf" ]]; then
    set_check_error "${OUTPUT_DIR_NAME}/nginx.conf not found (run ./swiftdeploy init)"
    return 1
  fi

  local test_output
  # nginx -t resolves static upstream hostnames at parse time. Provide a dummy
  # host mapping so syntax validation stays focused on config correctness.
  # pid is set in generated nginx.conf for unprivileged images; do not add -g pid (duplicate directive).
  if test_output="$(docker run --rm --add-host app:127.0.0.1 -v "$GENERATED_DIR/nginx.conf:/etc/nginx/nginx.conf:ro" "$nginx_image" nginx -t 2>&1)"; then
    return 0
  fi

  test_output="$(printf '%s' "$test_output" | tr '\n' ' ' | sed -e 's/[[:space:]]\+/ /g' -e 's/^ //;s/ $//')"
  set_check_error "nginx config syntax check failed: ${test_output}"
  return 1
}

validate_cmd() {
  local failures=0

  # Keep generated artifacts synchronized before preflight checks.
  if ! init_cmd >/dev/null; then
    die "validate pre-step failed: unable to generate configs from manifest"
  fi

  # Keep check order stable so output is predictable for operators and screenshots.
  if ! run_check "1) manifest.yaml exists + valid YAML structure" check_manifest_yaml; then
    failures=$((failures + 1))
  fi
  if ! run_check "2) required fields present and non-empty" check_required_fields; then
    failures=$((failures + 1))
  fi
  if ! run_check "3) referenced Docker image exists locally" check_image_exists; then
    failures=$((failures + 1))
  fi
  if ! run_check "4) nginx host port not already in use" check_nginx_port_available; then
    failures=$((failures + 1))
  fi
  if ! run_check "5) generated nginx.conf syntax valid" check_nginx_syntax; then
    failures=$((failures + 1))
  fi

  if (( failures > 0 )); then
    hint "resolve failed checks above, then re-run: ./swiftdeploy validate"
    die "validate failed with ${failures} failing check(s)"
  fi

  log "validate complete: all checks passed"
}

cmd="${1:-}"
subarg="${2:-}"

# Command dispatcher for lifecycle actions.
case "$cmd" in
  init)
    init_cmd
    ;;
  validate)
    validate_cmd
    ;;
  build)
    build_cmd
    ;;
  deploy)
    deploy_cmd
    ;;
  promote)
    promote_cmd "$subarg"
    ;;
  teardown)
    teardown_cmd "$subarg"
    ;;
  *)
    echo "Usage: ./swiftdeploy {init|validate|build|deploy|promote <stable|canary>|teardown [--clean]}"
    exit 1
    ;;
esac
